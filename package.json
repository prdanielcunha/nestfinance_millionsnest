{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "check:api-contracts": "node scripts/check-api-contracts.mjs",
    "check:vercel-entrypoints": "node scripts/check-vercel-entrypoints.mjs",
    "check:saas-isolation": "tsx scripts/check-saas-isolation.ts",
    "check:brand-assets": "node scripts/check-brand-assets.mjs",
    "test:certification-gates": "tsx scripts/test-certification-checkers.ts",
    "test:universal-capture-i1": "tsx scripts/test-universal-capture-i1.ts",
    "test:universal-evidence-emulator": "FIREBASE_PROJECT_ID=nestfinance-i1-emulator npx firebase-tools@15.27.0 emulators:exec --only firestore --project nestfinance-i1-emulator \"tsx scripts/test-universal-evidence-firestore-emulator.ts && tsx scripts/test-universal-evidence-firestore-rules.ts\"",
    "test:universal-evidence-inbox-i2a": "tsx scripts/test-universal-evidence-inbox-i2a.ts",
    "test:universal-evidence-inbox-emulator": "FIREBASE_PROJECT_ID=nestfinance-inbox-i2a-emulator npx firebase-tools@15.27.0 emulators:exec --only firestore --project nestfinance-inbox-i2a-emulator \"tsx scripts/test-universal-evidence-inbox-emulator.ts\"",
    "test:universal-evidence-inbox-i2b": "tsx scripts/test-universal-evidence-inbox-i2b.ts",
    "test:universal-evidence-detail-emulator": "FIREBASE_PROJECT_ID=nestfinance-inbox-i2b-emulator npx firebase-tools@15.27.0 emulators:exec --only firestore --project nestfinance-inbox-i2b-emulator \"tsx scripts/test-universal-evidence-detail-emulator.ts\"",
    "test:universal-evidence-inbox-i2c": "tsx scripts/test-universal-evidence-inbox-i2c.ts",
    "test:universal-evidence-preview-emulator": "FIREBASE_PROJECT_ID=nestfinance-inbox-i2c-emulator npx firebase-tools@15.27.0 emulators:exec --only firestore --project nestfinance-inbox-i2c-emulator \"tsx scripts/test-universal-evidence-preview-emulator.ts\"",
    "test:universal-evidence-pdf-inspector-i2d": "tsx scripts/test-universal-evidence-pdf-inspector-i2d.ts",
    "test:universal-evidence-pdf-inspect-emulator": "FIREBASE_PROJECT_ID=nestfinance-inbox-i2d-emulator npx firebase-tools@15.27.0 emulators:exec --only firestore --project nestfinance-inbox-i2d-emulator \"tsx scripts/test-universal-evidence-pdf-inspect-emulator.ts\"",
    "test:universal-evidence-pdf-text-i2e": "tsx scripts/test-universal-evidence-pdf-text-i2e.ts",
    "test:universal-evidence-pdf-text-emulator": "FIREBASE_PROJECT_ID=nestfinance-inbox-i2e-emulator npx firebase-tools@15.27.0 emulators:exec --only firestore --project nestfinance-inbox-i2e-emulator \"tsx scripts/test-universal-evidence-pdf-text-emulator.ts\"",
    "prebuild": "npm run check:vercel-entrypoints && npm run check:brand-assets",
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase": "^12.15.0",
    "firebase-admin": "13.10.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-router-dom": "^7.18.0",
    "unpdf": "1.8.1",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.1",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@vercel/node": "^5.8.17",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
