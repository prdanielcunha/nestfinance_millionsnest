{
  "name": "NestFinance",
  "short_name": "NestFinance",
  "description": "Controle. Clareza. Confiança.",
  "start_url": "/",
  "display": "standalone",
  "background_color": "#081216",
  "theme_color": "#081216",
  "icons": [
    {
      "src": "/brand/nestfinance/nf-continuous/v2/icons/nestfinance-app-icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/brand/nestfinance/nf-continuous/v2/icons/nestfinance-app-icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/brand/nestfinance/nf-continuous/v2/icons/nestfinance-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "share_target": {
    "action": "/finance/capture/share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "files",
          "accept": [
            "image/jpeg",
            "image/png",
            "image/webp",
            "application/pdf"
          ]
        }
      ]
    }
  }
}
