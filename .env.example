# Environment template — values shown here are placeholders only.
# Configure real secrets and runtime values in the deployment environment (for example, Vercel).
# Never commit production credentials.

# Optional provider key. Only required by explicitly enabled/certified AI features.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Canonical application URL for callbacks and self-referential links.
APP_URL="MY_APP_URL"

NESTFINANCE_HANDOFF_REDEEM_ENABLED=false
NESTFINANCE_SESSION_RESOLVE_ENABLED=false
NESTFINANCE_SETUP_WRITE_ENABLED=false
NESTFINANCE_ACCOUNTS_WRITE_ENABLED=false
NESTFINANCE_FUNDS_WRITE_ENABLED=false
NESTFINANCE_CATEGORIES_WRITE_ENABLED=false
NESTFINANCE_ENTITIES_WRITE_ENABLED=false

# Count Capture external reading remains opt-in. Keep false until explicitly configured/certified.
NESTFINANCE_COUNT_CAPTURE_AI_ENABLED=false
# Provider model is operational configuration, not product semantics. Example intentionally omitted.
NESTFINANCE_COUNT_CAPTURE_VISION_MODEL=

# Firebase Admin credentials — server-side secrets. Leave blank in the repository.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Public bucket identifier, not a credential. Server access remains authorized separately.
FIREBASE_STORAGE_BUCKET=millionsnest.firebasestorage.app
